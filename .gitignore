# ============================================================
# TourGuard AI — .gitignore
# ============================================================

# --------------- Node.js ---------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.yarn/unplugged
.pnp.*
lerna-debug.log*

# --------------- Python ---------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
.Python
pip-log.txt
pip-delete-this-directory.txt
*.pyo

# --------------- Environment / Secrets ---------------
.env
.env.*
!.env.example

# --------------- Build Artifacts ---------------
dist/
build/
out/
*.tgz
coverage/
.nyc_output/
*.lcov

# --------------- IDE / Editor ---------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --------------- OS Files ---------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --------------- Mobile (React Native / Expo) ---------------
*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM
.expo/
.expo-shared/
android/app/build/
android/.gradle/
ios/Pods/
ios/build/

# --------------- Logs ---------------
logs/
*.log

# --------------- Docker ---------------
docker-compose.override.yml

# --------------- Misc ---------------
.cache/
tmp/
temp/
